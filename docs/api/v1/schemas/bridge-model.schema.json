{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guitars2:schema:v1:bridge-model",
  "title": "BridgeModel",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "catalogId", "name", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "catalogId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "bridgeType": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "Create": {
      "title": "BridgeModel nested create input",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bridgeType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Reference": {
      "title": "BridgeModel reference",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
