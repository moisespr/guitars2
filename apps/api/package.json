{
  "name": "@guitars2/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:migrate": "tsx src/infrastructure/postgres/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:postgres": "tsx src/infrastructure/postgres/migrate.ts --database-url-env TEST_DATABASE_URL && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.0.0",
    "kysely": "^0.28.7",
    "pg": "^8.16.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
