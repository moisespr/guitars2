# Local development values only. Choose a non-production password before copying
# this file to .env. If the password includes URL-reserved characters, URL-encode
# it in DATABASE_URL and TEST_DATABASE_URL.
POSTGRES_USER=guitars2
POSTGRES_TEST_USER=guitars2_test
POSTGRES_DB=guitars2
POSTGRES_TEST_DB=guitars2_test
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

DATABASE_URL=postgresql://guitars2:replace-with-a-local-password@127.0.0.1:5432/guitars2
TEST_DATABASE_URL=postgresql://guitars2_test:replace-with-a-local-password@127.0.0.1:5433/guitars2_test
